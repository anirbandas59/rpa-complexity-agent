# ── LLM Configuration ──────────────────────────────────────────
# Options: anthropic | openai | watsonx | ollama
DEFAULT_LLM_PROVIDER=anthropic

# Model name for the chosen provider
# anthropic: claude-sonnet-4-5
# openai:    gpt-4o
# ollama:    llama3
DEFAULT_LLM_MODEL=claude-sonnet-4-6

# ── Provider API Keys ──────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# ── watsonx (required only if DEFAULT_LLM_PROVIDER=watsonx) ───
WATSONX_API_KEY=
WATSONX_URL=
WATSONX_PROJECT_ID=

# ── Ollama (required only if DEFAULT_LLM_PROVIDER=ollama) ─────
OLLAMA_BASE_URL=http://localhost:11434

# ── Application ────────────────────────────────────────────────
LOG_LEVEL=INFO
OUTPUT_DIR=data/outputs
TEMP_DIR=data/temp