# ── Stage 1: builder ──────────────────────────────────────────────────────────
FROM python:3.11-slim AS builder

WORKDIR /app

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1

# No native extensions in frontend deps — no apt packages needed

# UV binary from official image
COPY --from=ghcr.io/astral-sh/uv:0.6.14 /uv /usr/local/bin/uv

# Dependency files first (layer cache)
COPY pyproject.toml .
COPY uv.lock .

# Install frontend optional extra — add --frozen (was missing)
RUN uv sync --no-dev --frozen --extra frontend

# Application source
COPY frontend/ frontend/
COPY config/ config/
COPY core/ core/

# Streamlit config — created here, COPYd to runtime stage
RUN mkdir -p .streamlit \
    && printf '[server]\nheadless = true\naddress = "0.0.0.0"\nport = 8501\n[browser]\ngatherUsageStats = false\n[client]\nshowErrorDetails = "none"\n' \
       > .streamlit/config.toml


# ── Stage 2: runtime ──────────────────────────────────────────────────────────
FROM gcr.io/distroless/python3-debian12:nonroot

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/app/.venv/bin:$PATH" \
    PYTHONPATH="/app"

COPY --from=builder --chown=65532:65532 /app /app

LABEL org.opencontainers.image.source="https://github.com/anirbandas59/rpa-complexity-agent"
LABEL org.opencontainers.image.version="0.1.0"
LABEL org.opencontainers.image.description="RPA Complexity Assessment Frontend"

USER nonroot

EXPOSE 8501

# stdlib-only healthcheck: hits Streamlit's built-in health endpoint
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s \
  CMD ["/app/.venv/bin/python", "-c", \
       "import urllib.request, sys; r = urllib.request.urlopen('http://localhost:8501/_stcore/health', timeout=8); sys.exit(0 if r.status == 200 else 1)"]

CMD ["/app/.venv/bin/streamlit", "run", "frontend/app.py", \
     "--server.port", "8501", \
     "--server.address", "0.0.0.0"]
