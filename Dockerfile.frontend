FROM python:3.11-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1

# Install curl for healthcheck
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

# Install UV from official image (avoids pip bootstrap, pinned to latest release)
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Copy dependency files
COPY pyproject.toml .
COPY uv.lock .

# Install frontend optional extra (streamlit + httpx) without dev dependencies
RUN uv sync --no-dev --extra frontend

# Copy frontend code and config
COPY frontend/ frontend/
COPY config/ config/
COPY core/ core/

# Streamlit config
RUN mkdir -p .streamlit
RUN printf '[server]\nheadless = true\naddress = "0.0.0.0"\nport = 8501\n[browser]\ngatherUsageStats = false\n[client]\nshowErrorDetails = "none"\n' \
    > .streamlit/config.toml

# Drop root: create unprivileged user and hand over the workdir
RUN useradd -m appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE 8501

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s \
  CMD curl -f http://localhost:8501/_stcore/health || exit 1

CMD ["uv", "run", "streamlit", "run", "frontend/app.py", \
     "--server.port", "8501", \
     "--server.address", "0.0.0.0"]
