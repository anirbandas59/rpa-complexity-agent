FROM python:3.11-slim

WORKDIR /app

# Install curl for healthcheck
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

# Install UV
RUN pip install uv

# Copy dependency files
COPY pyproject.toml .
COPY uv.lock* .

# Install dependencies (frontend needs streamlit + httpx only
# but we install full deps to avoid maintaining two lists)
RUN uv sync --no-dev

# Copy frontend code and config
COPY frontend/ frontend/
COPY config/ config/
COPY core/ core/

# Streamlit config
RUN mkdir -p .streamlit
RUN printf '[server]\nheadless = true\naddress = "0.0.0.0"\nport = 8501\n[browser]\ngatherUsageStats = false\n' \
    > .streamlit/config.toml

EXPOSE 8501

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s \
  CMD curl -f http://localhost:8501/_stcore/health || exit 1

CMD ["uv", "run", "streamlit", "run", "frontend/app.py", \
     "--server.port", "8501", \
     "--server.address", "0.0.0.0"]
