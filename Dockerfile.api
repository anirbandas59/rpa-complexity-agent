# ── Stage 1: builder ──────────────────────────────────────────────────────────
FROM python:3.11-slim AS builder

WORKDIR /app

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1

# Build-time deps only — none of these land in the runtime image
RUN apt-get update && apt-get install -y --no-install-recommends \
    libmupdf-dev \
    libfreetype6-dev \
    libjpeg-dev \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# UV binary from official image
COPY --from=ghcr.io/astral-sh/uv:0.6.14 /uv /usr/local/bin/uv

# Dependency files first (layer cache)
COPY pyproject.toml .
COPY uv.lock .

# Install into /app/.venv — --frozen ensures lockfile is the authority
RUN uv sync --no-dev --frozen

# Application source
COPY core/ core/
COPY agents/ agents/
COPY tools/ tools/
COPY llm/ llm/
COPY api/ api/
COPY config/ config/
COPY data/reference/ data/reference/
COPY data/templates/ data/templates/

# Materialise empty runtime dirs so COPY --from=builder picks them up
# Volume mounts in docker-compose shadow the placeholder files at runtime
RUN mkdir -p data/outputs data/temp logs \
    && touch data/outputs/.gitkeep data/temp/.gitkeep logs/.gitkeep


# ── Stage 2: runtime ──────────────────────────────────────────────────────────
FROM gcr.io/distroless/python3-debian12:nonroot

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/app/.venv/bin:$PATH" \
    PYTHONPATH="/app"

# Copy entire workdir from builder, owned by distroless nonroot UID 65532
COPY --from=builder --chown=65532:65532 /app /app

LABEL org.opencontainers.image.source="https://github.com/anirbandas59/rpa-complexity-agent"
LABEL org.opencontainers.image.version="0.1.0"
LABEL org.opencontainers.image.description="RPA Complexity Assessment API"

USER nonroot

EXPOSE 8000

# stdlib-only healthcheck: no curl or shell required
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s \
  CMD ["/app/.venv/bin/python", "-c", \
       "import urllib.request, sys; r = urllib.request.urlopen('http://localhost:8000/api/health', timeout=8); sys.exit(0 if r.status == 200 else 1)"]

CMD ["/app/.venv/bin/uvicorn", "api.main:app", \
     "--host", "0.0.0.0", "--port", "8000", \
     "--workers", "4", \
     "--timeout-keep-alive", "120", \
     "--limit-max-body-size", "52428800"]
